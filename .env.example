# Keep real credentials in .env or deployment secret settings only.
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2
PORT=5000
FLASK_DEBUG=0
LOG_LEVEL=INFO
MAX_TRANSCRIPT_CHARS=120000
MAX_CHUNKS=180
MAX_CACHED_VIDEOS=5

# Local/direct development: 0. Set to 1 on Render behind its trusted reverse proxy.
TRUST_PROXY_HOPS=0
